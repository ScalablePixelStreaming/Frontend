{
  "name": "@tensorworks/libspsfrontend",
  "version": "1.1.0",
  "description": "The Scalable Pixel Streaming Frontend Library consuming Epic Games' Pixel Streaming Frontend",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "scripts": {
    "build:cjs": "tsc --project tsconfig.cjs.json",
    "build:esm": "tsc --project tsconfig.esm.json",
    "build": "npm run build:cjs && npm run build:esm",
    "build-dev": "npm run build",
    "build-prod": "npm run build"
  },
  "author": "TensorWorks Pty Ltd",
  "license": "MIT",
  "dependencies": {
    "@epicgames-ps/lib-pixelstreamingfrontend-ue5.6": "^0.2.3",
    "@epicgames-ps/lib-pixelstreamingfrontend-ui-ue5.6": "^0.2.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/webxr": "^0.5.21"
  }
}
